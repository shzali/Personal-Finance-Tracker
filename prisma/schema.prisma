// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model MonthExpenses {
  month                  String
  year                   String
  income                 Int
  investingPercentage    Int
  funLimit               Int
  totalNecessaryExpenses Int
  totalFunExpenses       Int
  expenses               Expense[]

  @@id(name: "id", [month, year])
}

model Expense {
  id     Int     @id @default(autoincrement())
  amount Int
  isFun  Boolean

  month        MonthExpenses @relation(fields: [expenseMonth, expenseYear], references: [month, year])
  expenseMonth String
  expenseYear  String

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  expenses Expense[]
}
